APP_NAME="Task Reminder"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://task.attaambo.dev

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: Supabase (session pooler) ---
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=
DB_SSLMODE=require

# --- Session / cache / queue ---
# The scheduler and queue worker are separate systemd services, so the
# queue must stay on the database driver for jobs to survive restarts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# --- Mail: use a real provider in production ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@attaambo.dev"
MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=

# --- Siakang Python bridge ---
# Absolute path to the `uv` binary. Set it explicitly because Octane runs
# with a restricted PATH (defaults to /root/.local/bin/uv when empty).
SIAKANG_UV=/root/.local/bin/uv

# --- Frontend URL used in emails and Telegram links ---
FRONTEND_URL=https://task.attaambo.dev

# --- Octane ---
OCTANE_SERVER=frankenphp
# TLS is terminated by Cloudflare; the app itself listens on plain HTTP.
OCTANE_HTTPS=
