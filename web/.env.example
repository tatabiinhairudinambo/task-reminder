# Copy to .env.local and fill in. Next loads .env.local automatically.

# --- Database (same Supabase/Postgres instance the Laravel API uses) --------
# Pooled connection (PgBouncer, port 6543) used at runtime.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
# Direct connection (port 5432) used by the Prisma CLI.
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# --- Auth -------------------------------------------------------------------
# HTTP-only session cookie signing. Generate: openssl rand -base64 32
JWT_SECRET=
# Must be the SAME value as server/.env APP_KEY (base64:...) so Siakang
# credentials encrypted by Laravel can be decrypted (and vice versa).
LARAVEL_APP_KEY=base64:
# APP_KEY alias used by signed verification URLs; falls back to JWT_SECRET.
APP_KEY=

# --- URLs -------------------------------------------------------------------
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# --- Mail (Resend HTTP API) -------------------------------------------------
# MAIL_PROVIDER=log prints emails to the function log instead.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Cron (Vercel sends Authorization: Bearer $CRON_SECRET) -----------------
CRON_SECRET=

# --- Siakang bridge ---------------------------------------------------------
# On Vercel set an HTTP endpoint exposing server/siakang-sync's JSON contract.
SIAKANG_BRIDGE_URL=
# Locally, the bridge is spawned from server/siakang-sync/.venv.
SIAKANG_PYTHON=
SIAKANG_BRIDGE_ENABLED=false

# --- Misc -------------------------------------------------------------------
BCRYPT_ROUNDS=12
